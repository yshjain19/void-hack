# ─────────────────────────────────────────────────────────────
# ForensIQ — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=forensiq
POSTGRES_PASSWORD=forensiq_secret
POSTGRES_DB=forensiq_db

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=forensiq_neo4j

# App Security
SECRET_KEY=change_me_to_a_random_32_char_string

# LLM Provider: "mock" | "openai" | "ollama" | "gemini" | "anthropic"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434

# Frontend
VITE_API_BASE_URL=http://localhost:8000
